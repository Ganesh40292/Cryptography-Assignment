{
  "name": "chacha20-cipherforge-workspace",
  "version": "1.0.0",
  "description": "ChaCha20 CipherForge — Interactive ARX Cryptographic Engine & RFC 8439 Studio",
  "private": true,
  "scripts": {
    "install:web": "npm --prefix chacha20-cipher/web install",
    "build": "node build.js",
    "dev": "npm --prefix chacha20-cipher/web run dev",
    "preview": "npm --prefix chacha20-cipher/web run preview",
    "test:java": "mvn -f chacha20-cipher/pom.xml test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "katex": "^0.18.9",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "vite": "^5.4.2"
  },
  "keywords": [
    "chacha20",
    "rfc-8439",
    "cryptography",
    "threejs",
    "security"
  ],
  "author": "Ganesh Prasad",
  "license": "MIT"
}
