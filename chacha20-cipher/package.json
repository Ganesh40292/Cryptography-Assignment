{
  "name": "chacha20-cipher",
  "version": "1.0.0",
  "description": "ChaCha20 Stream Cipher Studio & RFC 8439 Visualizer",
  "private": true,
  "scripts": {
    "dev": "vite ./web --port 8439 --strictPort --open",
    "build": "vite build ./web && node -e \"require('fs').cpSync('web/dist', 'dist', {recursive: true})\"",
    "preview": "vite preview ./web --port 8439 --strictPort",
    "start": "vite ./web --port 8439 --strictPort --open"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "vite": "^5.4.2"
  }
}
